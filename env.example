# Copy to .env and adjust for your machine (loaded by pydantic-settings, prefix ISC_).

# Path to the llama-cpp-spark checkout that holds the 10-K corpus and eval results.
ISC_SPARK_REPO=~/projects/llama-cpp-spark

# Simple Jev logit-classifier backend, local path (`isc run --backend llamacpp`): llama-server,
# qwen3.8-27b by default. The Spark keeps one large model resident at a time, so this is the only
# local server this project needs.
ISC_JEV_BASE_URL=http://127.0.0.1:8084
ISC_JEV_MODEL=qwen3.8-27b

# Simple Jev logit-classifier backend, hosted path (`isc run --backend typesafe`): TypeSafe's
# actual Jev, as the control for "did using qwen introduce issues". Bare names (no ISC_ prefix),
# identical to jev-email-cascade's own .env.example, so one .env serves both projects.
# TypeSafe direct takes precedence over OpenRouter when both are set.
#
# Route A: OpenRouter (no waitlist). Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# Pin the dated build once thresholds are tuned against it (echoed back in every response's
# `model` field, and recorded in run.json) -- e.g. JEV_MODEL=typesafe/jev-1.13-20260917.
# JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions   # override only if it moves
#
# Route B: TypeSafe direct -- only if an early-access key has arrived.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_SYSTEMONE_URL=https://api.typesafe.ai/v1/systemone

# Generative arbiter for escalated disagreements: a hosted frontier model, not a second local
# server. Bare names (no ISC_ prefix), same as llama-cpp-spark / jev-email-cascade, so one .env
# serves every project in the family.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for a different OpenAI-compatible host
ISC_GEN_MODEL=gpt-5.6-terra
ISC_GEN_REASONING_EFFORT=low

# Fallback: point the arbiter at a second local llama-server instead, on a box with spare
# capacity (uncomment both; ISC_GEN_BASE_URL then means the local server, not the OpenAI route).
# ISC_GEN_PROVIDER=local
# ISC_GEN_BASE_URL=http://127.0.0.1:8082/v1
# ISC_GEN_MODEL=gpt-oss-120b
